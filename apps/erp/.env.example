# Public build configuration only. Never use service_role or sb_secret keys here.
VITE_SUPABASE_DEPLOYMENT=hosted
VITE_SUPABASE_URL=https://project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY
VITE_ERP_API_URL=https://api.example.test
# Optional: a separately configured fiscal gateway, using its exact HTTPS origin.
VITE_A1_API_URL=
# For self-hosted Supabase Auth/Storage, use VITE_SUPABASE_DEPLOYMENT=self-hosted
# and VITE_SUPABASE_URL=https://auth.example.test with that installation's public anon key.
# A public sb_publishable key is also accepted when the installed gateway supports it.
# Self-hosted Auth requires a canonical HTTPS DNS hostname, without an IP address or custom port.
# URLs must be origins only: no credentials, paths, query strings or fragments.
