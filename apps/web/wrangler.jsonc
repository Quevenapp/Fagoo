{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fagoo-web",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "vars": { "FAGOO_API_ORIGIN": "" },
}
