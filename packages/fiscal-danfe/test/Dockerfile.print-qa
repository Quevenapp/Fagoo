# Local QA converter only. Never part of the fiscal runtime or an ERP deployment.
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 fonts-liberation2 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir weasyprint==70.0
COPY render_offline.py /render_offline.py
ENTRYPOINT ["python", "/render_offline.py"]
