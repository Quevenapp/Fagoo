# Exact allowlist: public ITI trust anchors, checked against the source manifest.
# Never add A1 certificates, personal certificates or any private key here.
!/packages/fiscal-vault/trust/icp-brasil-v4.pem
!/packages/fiscal-vault/trust/icp-brasil-v5.pem
!/packages/fiscal-vault/trust/icp-brasil-v6.pem
