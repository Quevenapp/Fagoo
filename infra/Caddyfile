{
  admin off
  auto_https off
}
:8080 {
  @allowed_origin header Origin {$FAGOO_WEB_ORIGIN}
  header @allowed_origin {
    Access-Control-Allow-Origin "{$FAGOO_WEB_ORIGIN}"
    Vary Origin
    Access-Control-Allow-Headers "Authorization, apikey, Content-Type, x-client-info, x-upsert, x-supabase-api-version"
    Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS, HEAD"
    Access-Control-Expose-Headers "Content-Range, Range, X-Total-Count"
  }
  @preflight method OPTIONS
  respond @preflight 204
  route {
  # Container liveness must remain healthy during an intentional update.
  respond /healthz 200
  # The updater stays reachable while application writes are paused.
  handle_path /_fagoo/system/* {
    reverse_proxy unix//run/fagoo-updater/agent.sock
  }
  @maintenance file {
    root /run/fagoo-updater
    try_files maintenance
  }
  respond @maintenance "FAGOO is updating. Please retry shortly." 503
  # Upstream Auth/REST may emit wildcard CORS. The gateway owns the single
  # allowed origin above, including on errors and non-preflight responses.
  handle_path /auth/v1/* {
    reverse_proxy auth:9999 {
      header_down -Access-Control-Allow-Origin
    }
  }
  handle_path /rest/v1/* {
    reverse_proxy rest:3000 {
      header_down -Access-Control-Allow-Origin
    }
  }
  handle_path /storage/v1/* {
    reverse_proxy storage:5000 {
      header_down -Access-Control-Allow-Origin
      header_up X-Forwarded-Path {http.request.orig_uri}
    }
  }
  respond 404
  }
}
